{
  // $schema provides code completion hints to IDEs.
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  // Match previous `npm audit --audit-level=low` behavior.
  "low": true,
  "allowlist": [
    // Dev-only. minimatch <11.0.1 (GHSA-g3hv-75wg-m249). The fix is 11.0.1+,
    // and the tree still needs minimatch 3, 9, and 10 (eslint 9, glob 7/10).
    // Not shipped in the extension.
    {
      "GHSA-g3hv-75wg-m249": {
        "active": true,
        "notes": "Dev-only via eslint, jest, and web-ext. No patched 3.x/9.x/10.x; 11.x would break those callers.",
        "expiry": "2026-12-01"
      }
    },
    // Dev-only. glob 9–14.0.1 (GHSA-3g3m-2fjr-6pw4). Jest uses glob 10.5.0, the
    // newest 10.x, and the fix is glob >=14.0.2. Not shipped in the extension.
    {
      "GHSA-3g3m-2fjr-6pw4": {
        "active": true,
        "notes": "Dev-only via jest. Latest glob 10 is still vulnerable; 14.x is an incompatible major.",
        "expiry": "2026-12-01"
      }
    },
    // Dev-only. deepmerge >=4.2.0 <=4.3.1 (GHSA-gcqx-w48m-w2h4). 4.3.1 is the
    // newest release and is still vulnerable. Not shipped in the extension.
    {
      "GHSA-gcqx-w48m-w2h4": {
        "active": true,
        "notes": "Dev-only via jest and web-ext. No patched deepmerge release on npm yet.",
        "expiry": "2026-12-01"
      }
    }
  ]
}
